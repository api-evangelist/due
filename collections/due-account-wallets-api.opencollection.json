{
  "opencollection": "1.0.0",
  "info": {
    "name": "Due Account Account Wallets API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account Wallets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List wallets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.due.network/v1/wallets"
          },
          "docs": "Lists all wallets linked to the account"
        },
        {
          "info": {
            "name": "Create wallet",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/wallets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates wallet and links it to the account"
        }
      ]
    }
  ],
  "bundled": true
}