              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Order in which results should be returned (e.g., `asc`, `desc`)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ]
          },
          "docs": "List a paginated list of recipients"
        },
        {
          "info": {
            "name": "Create recipient",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/recipients",
            "body": {
              "type": "json",
              "data": "{}"
            }
