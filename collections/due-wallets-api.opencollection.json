{
  "opencollection": "1.0.0",
  "info": {
    "name": "Due Account Wallets API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Wallets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get wallet balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.due.network/v1/wallets/:walletId/balance",
            "params": [
              {
                "name": "walletId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves balances for a specific wallet"
        }
      ]
    }
  ],
  "bundled": true
}