              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit transfer intent for an execution on blockchain."
        },
        {
          "info": {
            "name": "Create transfer intent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/transfer_intents",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
