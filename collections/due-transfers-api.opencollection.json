{
  "opencollection": "1.0.0",
  "info": {
    "name": "Due Account Transfers API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get transfer details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.due.network/v1/transfers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the resource."
              }
            ]
          },
          "docs": "Get details of a specific transfer by id."
        },
        {
          "info": {
            "name": "List all transfers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.due.network/v1/transfers",
            "params": [
              {
                "name": "next",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination to fetch the next set of results."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Order in which results should be returned (e.g., `asc`, `desc`)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date for filtering results (ISO 8601 format)."
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date for filtering results (ISO 8601 format)."
              },
              {
                "name": "includeEmpty",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves a paginated list of transfers."
        },
        {
          "info": {
            "name": "Create transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/transfers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiate a transfer for a created quote and provided details."
        },
        {
          "info": {
            "name": "post_v1-transfers-estimate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/transfers/estimate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "Create a funding address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/transfers/:id/funding_address",
