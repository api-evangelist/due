              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a funding address for a specific transfer by id"
        },
        {
          "info": {
            "name": "Create a transfer intent for a transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/transfers/:id/transfer_intent",
