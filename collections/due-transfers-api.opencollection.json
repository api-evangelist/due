              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a transfer intent for the specified transfer ID."
        },
        {
          "info": {
            "name": "Create a transfer quote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/transfers/quote",
            "body": {
              "type": "json",
              "data": "{}"
            }
