{
  "opencollection": "1.0.0",
  "info": {
    "name": "Due Account TOS API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "TOS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get TOS data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.due.network/v1/tos/:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get TOS data"
        },
        {
          "info": {
            "name": "Manually accept TOS",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.due.network/v1/tos/:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Manually accept TOS"
        }
      ]
    }
  ],
  "bundled": true
}